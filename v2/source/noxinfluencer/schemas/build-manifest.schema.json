{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noxinfluencer.com/schemas/skill-build-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime",
    "source_files",
    "output_files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "runtime": {
      "enum": [
        "cli",
        "mcp"
      ]
    },
    "source_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "output_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
