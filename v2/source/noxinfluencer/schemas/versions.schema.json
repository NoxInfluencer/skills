{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noxinfluencer.com/schemas/skill-versions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_version",
    "npm_version",
    "skill_version",
    "plugin_version",
    "capability_registry_version",
    "backend_version",
    "plugin_manifest_schema",
    "deployment",
    "snapshots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "node_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "npm_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "plugin_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 64
    },
    "capability_registry_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 64
    },
    "backend_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "plugin_manifest_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source",
        "path",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "const": "schemas/codex-plugin-manifest-v1.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "url",
        "oauth_resource"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "oauth_resource": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^snapshots/[a-z0-9-]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
